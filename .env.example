# Copy this file to `.env` and fill in the values you have.
# Every extractor degrades gracefully if its key is missing (it will fall
# back to cached data in data/raw/ or skip that source with a logged
# warning) — you do not need every key to run the pipeline.

# GitHub REST API — optional but strongly recommended.
# GitHub's search endpoint specifically (not the general API) is capped at
# 10 requests/minute unauthenticated, 30/minute with a token — the pipeline
# makes ~18 search calls per run, so without a token you may hit that limit
# on repeated runs in quick succession (you'll see WARNING/retry lines in
# the log; the run still completes, just with fewer records from GitHub).
# Create one at: https://github.com/settings/tokens (no special scopes needed
# for public repo search).
GITHUB_TOKEN=

# Hugging Face Hub API — optional. Only needed for higher rate limits or
# access to gated models; public model search works without it.
# Create one at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# YouTube Data API v3 — required for live video extraction.
# Create one at: https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first).
YOUTUBE_API_KEY=

# --- Pipeline tuning -------------------------------------------------------

# HTTP request timeout, in seconds, for all extractor API calls.
REQUEST_TIMEOUT=15

# Max retry attempts (with exponential backoff) per API call.
MAX_RETRIES=4

# Target total record count the pipeline aims for (informational; actual
# count depends on live API responses).
TARGET_TOTAL_RECORDS=280

# An entity is tagged "New/Recently added" if its last-updated/published
# date is within this many days of the pipeline run.
RECENT_DAYS_THRESHOLD=30

# Output directories.
DATA_DIR=data
RAW_DIR=data/raw
